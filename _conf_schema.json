  "embedding_backend": {
    "type": "object",
    "description": "嵌入 · 后端选择",
    "hint": "本地模型路径在下方；云端嵌入可使用框架中真正支持/embeddings的模型。",
    "items": {
      "mode": {
        "type": "string",
        "description": "嵌入方式",
        "default": "本地模型（FastEmbed）",
        "hint": "LLM增强先整理语义再交给真实嵌入模型；不会让聊天LLM随意编造向量。",
        "options": [
          "本地模型（FastEmbed）",
          "框架嵌入提供商",
          "LLM增强＋本地嵌入",
          "LLM增强＋框架嵌入"
        ]
      },
      "api_model": {
        "type": "string",
        "description": "对外嵌入模型名",
        "default": "BAAI/bge-small-zh-v1.5",
        "hint": "调用本机/embeddings时填写的名称；更换真实模型时应一并更新。"
      },
      "dimensions": {
        "type": "int",
        "description": "真实向量维度",
        "default": 512,
        "hint": "必须匹配实际模型输出。改变模型、维度或LLM整理策略后，旧向量索引需要重建。"
      },
      "local_model_name": {
        "type": "string",
        "description": "本地FastEmbed模型名",
        "default": "BAAI/bge-small-zh-v1.5",
        "hint": "可换为FastEmbed支持的其他嵌入模型；目录必须含它要求的ONNX与分词文件。"
      },
      "provider_id": {
        "type": "string",
        "description": "框架嵌入提供商ID",
        "default": "",
        "hint": "仅框架模式使用。应选择真正支持嵌入的提供商，不能选本桥接自身或普通聊天提供商。"
      },
      "batch_size": {
        "type": "int",
        "description": "本地嵌入批量",
        "default": 8,
        "hint": "2核2GB先使用8；模型长度上限由所选模型决定，长文本应由上游切片。"
      },
      "llm_provider_id": {
        "type": "string",
        "description": "LLM语义整理提供商ID",
        "default": "",
        "hint": "仅LLM增强模式；留空复用下方重排聊天提供商ID。",
        "_special": "select_provider"
      },
      "llm_timeout_seconds": {
        "type": "int",
        "description": "LLM语义整理总超时（秒）",
        "default": 40,
        "hint": "含当前请求的所有整理批次。"
      },
      "llm_batch_size": {
        "type": "int",
        "description": "LLM整理批量",
        "default": 8,
        "hint": "每批输入条数；避免在一次请求中塞入大量聊天内容。"
      },
      "llm_max_chars": {
        "type": "int",
        "description": "LLM整理单条输入上限",
        "default": 4000,
        "hint": "超出返回错误，需先切片；不静默删除原文。"
      },
      "llm_cache_seconds": {
        "type": "int",
        "description": "LLM整理缓存（秒）",
        "default": 3600,
        "hint": "相同原文在当前进程内复用整理结果；LLM输出不保证跨重启完全一致。"
      }
    },
    "invisible": true
  },
  "rerank_backend": {
    "type": "object",
    "description": "重排 · 后端选择",
    "items": {
      "mode": {
        "type": "string",
        "description": "重排方式",
        "default": "LLM评分",
        "hint": "三种方式都输出原始文档索引和相关性分数。",
        "options": [
          "LLM评分",
          "本地模型（FastEmbed）",
          "框架重排提供商"
        ]
      },
      "api_model": {
        "type": "string",
        "description": "对外重排模型名",
        "default": "llm-rerank",
        "hint": "本机/rerank对外使用的别名；切换后端可以保持别名，调用方无需改地址。"
      },
      "local_model_name": {
        "type": "string",
        "description": "本地FastEmbed重排模型名",
        "default": "Xenova/ms-marco-MiniLM-L-6-v2",
        "hint": "该模型已在你的缓存包中。它以英语训练为主；中文效果需用真实查询验证。"
      },
      "local_model_dir": {
        "type": "string",
        "description": "本地重排模型目录",
        "default": "",
        "hint": "相对路径按插件数据目录解析；可填写绝对路径。目录中应含onnx/model.onnx和tokenizer.json。",
        "invisible": true
      },
      "provider_id": {
        "type": "string",
        "description": "框架重排提供商ID",
        "default": "",
        "hint": "只在框架模式使用；不要选择本桥接自身。"
      },
      "threads": {
        "type": "int",
        "description": "本地重排CPU线程",
        "default": 1,
        "hint": "2核2GB先使用1。"
      },
      "batch_size": {
        "type": "int",
        "description": "本地重排批量",
        "default": 4,
        "hint": "小批量减少峰值内存。"
      },
      "sigmoid": {
        "type": "bool",
        "description": "本地分数使用sigmoid",
        "default": true,
        "hint": "将原始logit映射到0到1，不改变排序；不同后端分数不宜视作校准概率。"
      }
    },
    "invisible": true
  },
  "llm_provider_id": {
    "type": "string",
